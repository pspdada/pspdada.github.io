---
const width = 435;
const height = 50;
const src = `https://readme-typing-svg.demolab.com?font=Fira+Code&pause=1000&width=${width}&lines=Hi+there+%F0%9F%91%8B+I'm+psp_dada!`;
---

<img
  src={src}
  alt="Typing SVG"
  width={width}
  height={height}
  loading="eager"
  decoding="async"
  class="typing-svg"
/>

<style>
  .typing-svg {
    display: block;
    max-width: 100%;
    height: auto;
    aspect-ratio: 435 / 50;
  }
</style>
